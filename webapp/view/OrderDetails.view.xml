<mvc:View
    controllerName="com.mehran.portfolio.zui5portfolio.controller.OrderDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">

    <Page
        id="orderDetailsPage"
        title="{i18n>orderDetails}"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <VBox
                class="sapUiContentPadding"
                width="100%">

                <MessageStrip
                    text="{i18n>mockDataWarning}"
                    type="Warning"
                    showIcon="true"
                    visible="{view>/usingMock}"
                    class="sapUiSmallMarginBottom" />

                <ObjectHeader
                    title="{orders>OrderID}"
                    intro="{orders>CustomerName}"
                    number="{
                        parts: [
                            { path: 'orders>Amount', type: 'sap.ui.model.odata.type.Decimal' },
                            { path: 'orders>CurrencyCode' }
                        ],
                        type: 'sap.ui.model.type.Currency',
                        formatOptions: {
                            showMeasure: false,
                            currencyCode: false
                        }
                    }"
                    numberUnit="{orders>CurrencyCode}">

                    <statuses>
                        <ObjectStatus
                            text="{orders>OrderStatus}"
                            state="{
                                path: 'orders>OrderStatus',
                                formatter: '.formatter.orderStatusState'
                            }" />
                    </statuses>
                </ObjectHeader>

                <Panel
                    headerText="{i18n>orderInformation}"
                    class="sapUiResponsiveMargin"
                    width="auto">

                    <f:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3"
                        labelSpanL="3"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="4"
                        emptySpanL="4"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false">

                        <Label text="{i18n>orderId}" />
                        <Text text="{orders>OrderID}" />

                        <Label text="{i18n>customer}" />
                        <Text text="{orders>CustomerName}" />

                        <Label text="{i18n>status}" />
                        <ObjectStatus
                            text="{orders>OrderStatus}"
                            state="{
                                path: 'orders>OrderStatus',
                                formatter: '.formatter.orderStatusState'
                            }" />

                        <Label text="{i18n>amount}" />
                        <ObjectNumber
                            number="{
                                parts: [
                                    { path: 'orders>Amount', type: 'sap.ui.model.odata.type.Decimal' },
                                    { path: 'orders>CurrencyCode' }
                                ],
                                type: 'sap.ui.model.type.Currency',
                                formatOptions: {
                                    showMeasure: false,
                                    currencyCode: false
                                }
                            }"
                            unit="{orders>CurrencyCode}" />

                    </f:SimpleForm>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
