<mvc:View
    controllerName="com.mehran.portfolio.zui5portfolio.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <f:DynamicPage
        id="portfolioPage"
        busy="{dashboard>/busy}"
        busyIndicatorDelay="0"
        headerExpanded="true"
        toggleHeaderOnTitleClick="false">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        text="{i18n>dashboardTitle}"
                        level="H1" />
                </f:heading>

                <f:expandedContent>
                    <Text text="{i18n>dashboardSubtitle}" />
                </f:expandedContent>

                <f:actions>
                    <Button
                        id="refreshButton"
                        text="{i18n>refresh}"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <VBox>
                    <Title
                        text="{i18n>welcomeTitle}"
                        level="H2" />

                    <Text text="{i18n>welcomeText}" />
                </VBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox
                class="sapUiContentPadding"
                width="100%">

                <MessageStrip
                    text="{i18n>mockDataWarning}"
                    type="Warning"
                    showIcon="true"
                    visible="{dashboard>/usingMock}"
                    class="sapUiSmallMarginBottom" />

                <MessageStrip
                    text="{dashboard>/errorMessage}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{dashboard>/hasError}"
                    class="sapUiSmallMarginBottom">
                    <link>
                        <Link
                            text="{i18n>retry}"
                            press=".onRetry" />
                    </link>
                </MessageStrip>

                <Title
                    text="{i18n>overview}"
                    level="H2"
                    class="sapUiSmallMarginBottom" />

                <HBox
                    wrap="Wrap"
                    width="100%"
                    class="sapUiSmallMarginBottom">

                    <VBox
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        width="15rem">

                        <GenericTile
                            header="{i18n>totalOrders}"
                            subheader="{i18n>allOrders}">

                            <TileContent>
                                <NumericContent
                                    value="{dashboard>/totalOrders}"
                                    icon="sap-icon://sales-order"
                                    withMargin="false" />
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <VBox
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        width="15rem">

                        <GenericTile
                            header="{i18n>openOrders}"
                            subheader="{i18n>awaitingCompletion}">

                            <TileContent>
                                <NumericContent
                                    value="{dashboard>/openOrders}"
                                    icon="sap-icon://pending"
                                    withMargin="false" />
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <VBox
                        class="sapUiSmallMarginBottom"
                        width="15rem">

                        <GenericTile
                            header="{i18n>completedOrders}"
                            subheader="{i18n>successfullyCompleted}">

                            <TileContent>
                                <NumericContent
                                    value="{dashboard>/completedOrders}"
                                    icon="sap-icon://accept"
                                    withMargin="false" />
                            </TileContent>
                        </GenericTile>
                    </VBox>
                </HBox>

                <Title
                    text="{i18n>recentOrders}"
                    level="H2"
                    class="sapUiSmallMarginBottom" />

                <Table
                    id="ordersTable"
                    growing="true"
                    growingThreshold="10"
                    noDataText="{i18n>noOrders}"
                    items="{
                        path: 'orders>/ZI_UI5_ORDER',
                        parameters: {
                            $count: true,
                            $select: 'OrderUUID,OrderID,CustomerName,OrderStatus,Amount,CurrencyCode'
                        },
                        sorter: {
                            path: 'OrderID',
                            descending: false
                        },
                        events: {
                            dataRequested: '.onOrdersRequested',
                            dataReceived: '.onOrdersReceived'
                        }
                    }">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title
                                text="{i18n>orders}"
                                level="H3" />

                            <ToolbarSpacer />

                            <Select
                                id="ordersStatusFilter"
                                width="11rem"
                                selectedKey="All"
                                change=".onStatusFilterChange">

                                <core:Item
                                    key="All"
                                    text="{i18n>allStatuses}" />

                                <core:Item
                                    key="Open"
                                    text="{i18n>statusOpen}" />

                                <core:Item
                                    key="In Progress"
                                    text="{i18n>statusInProgress}" />

                                <core:Item
                                    key="Completed"
                                    text="{i18n>statusCompleted}" />
                            </Select>

                            <Select
                                id="ordersSortField"
                                width="11rem"
                                selectedKey="OrderID"
                                change=".onSortChange">

                                <core:Item
                                    key="OrderID"
                                    text="{i18n>orderId}" />

                                <core:Item
                                    key="CustomerName"
                                    text="{i18n>customer}" />

                                <core:Item
                                    key="Amount"
                                    text="{i18n>amount}" />
                            </Select>

                            <Select
                                id="ordersSortDirection"
                                width="8rem"
                                selectedKey="asc"
                                change=".onSortChange">

                                <core:Item
                                    key="asc"
                                    text="{i18n>ascending}" />

                                <core:Item
                                    key="desc"
                                    text="{i18n>descending}" />
                            </Select>

                            <SearchField
                                id="ordersSearchField"
                                width="15rem"
                                placeholder="{i18n>searchOrders}"
                                liveChange=".onSearch" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column>
                            <Text text="{i18n>orderId}" />
                        </Column>

                        <Column>
                            <Text text="{i18n>customer}" />
                        </Column>

                        <Column>
                            <Text text="{i18n>status}" />
                        </Column>

                        <Column hAlign="End">
                            <Text text="{i18n>amount}" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onOrderPress">
                            <cells>
                                <ObjectIdentifier
                                    title="{orders>OrderID}" />

                                <Text
                                    text="{orders>CustomerName}" />

                                <ObjectStatus
                                    text="{orders>OrderStatus}"
                                    state="{
                                        path: 'orders>OrderStatus',
                                        formatter: '.formatter.orderStatusState'
                                    }" />

                                <ObjectNumber
                                    number="{
                                        parts: [
                                            { path: 'orders>Amount', type: 'sap.ui.model.odata.type.Decimal' },
                                            { path: 'orders>CurrencyCode' }
                                        ],
                                        type: 'sap.ui.model.type.Currency',
                                        formatOptions: {
                                            showMeasure: false,
                                            currencyCode: false
                                        }
                                    }"
                                    unit="{orders>CurrencyCode}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
