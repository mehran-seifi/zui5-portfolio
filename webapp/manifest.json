{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.mehran.portfolio.zui5portfolio",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "ordersService": {
        "uri": "/sap/opu/odata4/sap/zui5_sb_order/srvd/sap/zui5_sd_order/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "5ed381a6-dac7-443c-a387-97118083f68f"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.mehran.portfolio.zui5portfolio.i18n.i18n"
        }
      },
      "orders": {
        "dataSource": "ordersService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.mehran.portfolio.zui5portfolio.view",
        "async": true,
        "viewPath": "com.mehran.portfolio.zui5portfolio.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": ["TargetMain"]
        },
        {
          "name": "RouteOrderDetails",
          "pattern": "orders/{orderUUID}",
          "target": ["TargetOrderDetails"]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetOrderDetails": {
          "id": "OrderDetails",
          "name": "OrderDetails"
        }
      }
    },
    "rootView": {
      "viewName": "com.mehran.portfolio.zui5portfolio.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
